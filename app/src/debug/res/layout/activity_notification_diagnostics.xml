<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto" android:id="@+id/diagnostics_root"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:background="@color/obs_paper" android:fillViewport="true" android:clipToPadding="false">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
        android:orientation="vertical" android:paddingHorizontal="22dp" android:paddingTop="12dp" android:paddingBottom="28dp">
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical">
            <ImageButton android:id="@+id/back_button" android:layout_width="48dp" android:layout_height="48dp" android:padding="12dp" android:src="@drawable/obs_back" android:background="?attr/selectableItemBackgroundBorderless" android:contentDescription="@string/back" />
            <TextView style="@style/ObservationTitle" android:layout_width="0dp" android:layout_weight="1" android:text="@string/diagnostics_title" />
        </LinearLayout>
        <TextView style="@style/ObservationBody" android:layout_marginTop="8dp" android:layout_marginBottom="20dp" android:text="@string/diag_subtitle" />
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="24dp" android:background="@drawable/obs_hero">
            <TextView android:id="@+id/window_state" style="@style/ObservationBody" android:text="@string/diag_inactive" android:textColor="@color/obs_mint" />
            <TextView android:id="@+id/countdown" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="10dp" android:text="@string/diag_inactive_time" android:textSize="36sp" android:fontFamily="sans-serif-medium" android:textColor="@color/obs_white" />
            <TextView style="@style/ObservationBody" android:layout_marginTop="12dp" android:text="@string/diag_scope" android:textColor="@color/obs_mint" />
        </LinearLayout>
        <com.google.android.material.button.MaterialButton android:id="@+id/start_stop"
            android:layout_width="match_parent" android:layout_height="56dp" android:layout_marginTop="16dp"
            android:text="@string/diag_start" android:textAllCaps="false" android:textSize="14sp" app:cornerRadius="14dp" />
        <TextView android:id="@+id/connection_status" style="@style/ObservationBody" android:layout_marginTop="8dp" android:text="@string/service_description_off" />
        <TextView style="@style/ObservationBody" android:layout_marginTop="10dp" android:text="@string/diag_privacy_note" />
        <TextView android:id="@+id/read_error" style="@style/ObservationBody" android:layout_marginTop="10dp" android:text="@string/diag_unreadable" android:textColor="@color/obs_amber" android:visibility="gone" />
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="24dp" android:layout_marginBottom="12dp" android:orientation="horizontal" android:gravity="center_vertical">
            <TextView style="@style/ObservationRowTitle" android:layout_width="0dp" android:layout_weight="1" android:text="@string/diag_samples" android:textSize="15sp" />
            <TextView android:id="@+id/sample_count" style="@style/ObservationValue" />
        </LinearLayout>
        <LinearLayout android:id="@+id/empty_card" style="@style/ObservationCard" android:padding="24dp">
            <TextView style="@style/ObservationRowTitle" android:layout_width="match_parent" android:gravity="center" android:text="@string/diag_empty" />
            <TextView style="@style/ObservationBody" android:layout_marginTop="10dp" android:gravity="center" android:text="@string/diag_empty_hint" />
        </LinearLayout>
        <LinearLayout android:id="@+id/samples" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" />
    </LinearLayout>
</androidx.core.widget.NestedScrollView>
